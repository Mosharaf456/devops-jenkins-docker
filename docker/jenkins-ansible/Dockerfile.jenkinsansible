# FROM jenkins/jenkins:lts
FROM jenkins/jenkins:latest

LABEL maintainer="Mosharaf Hossain, Software Engineer, mosharaf111hossain@gmail.com" 

ARG DEBIAN_FRONTEND=noninteractive

USER root

# RUN apt-get update && \
#     apt-get install -y python3 python3-pip pipx curl vim sshpass ansible && \
#     apt-get clean

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip pipx curl vim sshpass ansible \
    && rm -rf /var/lib/apt/lists/*


# Install AWS CLI using pipx
RUN pipx install awscli

# Optional: Uncomment these lines if you need net-tools, telnet, procps
# RUN apt-get update && apt-get install -y --no-install-recommends \
#     net-tools \
#     telnet \
#     procps \
#     && rm -rf /var/lib/apt/lists/*   #Ensures future builds don’t re-download everything.

RUN apt-get update && apt-get install -y iputils-ping && apt-get clean && rm -rf /var/lib/apt/lists/*


USER jenkins

RUN mkdir -p /tmp/ansible/ && chmod -R 755 /tmp/ansible
COPY ./dist/ssh-key/remote-key /tmp/ansible/remote-key

COPY ./dist/ansible/inventory/hosts /tmp/ansible/hosts  
COPY ./dist/ansible/pbook/ /tmp/ansible/pbook

COPY ./dist/db/jenkins-ansible_db.sh /tmp/jenkins-ansible_db.sh
COPY ./dist/db/jenkins_people_db.txt /tmp/jenkins_people_db.txt


EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/usr/share/jenkins/jenkins.war"]
