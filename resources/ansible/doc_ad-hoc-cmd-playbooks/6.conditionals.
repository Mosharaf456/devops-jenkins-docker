Conditionals in ansible 

Ansible can use conditionals to execute tasks or plays when certain conditions are met.

to use conditional use the when statement



ansible -m setup -a "filter=ansible_os_family" dev

---
- hosts: dev
  become: true
  become_user: root
  tasks:
          - name: Shutdown Debian Systems
            command: /sbin/shutdown -t now
            when: ansible_os_family == "Debian"

---
- hosts: dev
  tasks:
    - name: Ansible Loop
      debug:
        msg: "{{ item }}"
      loop:
        - "hello1"
        - "hello2"
        - "hello3"
        - "hello4"
      when: 
        (ansible_os_family == "Debian" and ansible_distribution_major_version|int >= 6) 
        and (item in ["hello1", "hello2"])



---
- hosts: dev
  tasks:
    - apt:
        name: "{{ item }}"
        state: latest
      with_items:
        - postfix
        - tree



#############
---
- hosts: dev
  vars: 
    mail_services:
      - postfix
      - dovecot
  tasks:
    - apt:
        name: "{{ item }}"
        state: latest
      with_items: "{{ mail_services }}"

########### multi dimentinal array 
---
- hosts: dev
  vars:
    users:
      - name: 'jane'
        groups: 'wheel'
      - name: 'joe'
        groups: 'root'
  tasks:
    - user:
        name: "{{ item.name }}"
        state: present
        groups: "{{ item.groups }}"
      with_items: "{{ users }}"
#############
--- 
- hosts: dev
  tasks:
    - user:
        name: "{{ item.name }}"
        state: present
        groups: "{{ item.groups }}"
      with_items:
        - { name: 'jane', groups: 'wheel' }
        - { name: 'joe', groups: 'root' }
