---
- name: Set up the system environment
  hosts: dev
  become: yes  # Run tasks with elevated privileges (root)

  tasks:
    - name: Mount the OS media drive
      mount:
        path: /mnt/os_media
        src: /dev/cdrom
        fstype: iso9660
        state: mounted

    - name: Create local repository directory
      file:
        path: /etc/apt/sources.list.d/local_repo.list
        state: touch

    - name: Set up the local repository configuration
      template:
        src: local_repo.list.j2
        dest: /etc/apt/sources.list.d/local_repo.list

    - name: Update apt repository cache
      apt:
        update_cache: yes

    - name: Install required packages
      apt:
        name:
          - apache2
          - git
          - vim
        state: present

    - name: Enable and start required services
      service:
        name: "{{ item }}"
        state: started
        enabled: yes
      loop:
        - apache2
        - cron


