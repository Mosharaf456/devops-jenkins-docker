Steps for the installation of apache web server 

1. install latest package of apache2 
2. start, enable apache2 server 
3. Install latest package for firewalld 
4. start , enable firewalld service 
5. permit apache2 service at firewall
6. create simple html web page 
7. defining web server name i.e www.client1.e.com 
8. Update its entry in /etc/hosts file 

file name: 
7.webserver_apache_ufw.yml

---
- hosts: dev
  become: true
  tasks:
    - name: Install Apache2 server
      apt:
        name: apache2
        state: present
        update_cache: yes

    - name: Start and enable the web server
      service:
        name: apache2
        enabled: yes 
        state: started

    - name: Ensure UFW is installed 
      apt:
        name: ufw
        state: present
        update_cache: yes

    - name: Start and enable ufw
      service:
        name: ufw
        enabled: true
        state: started

          #    - name: Allow Apache through UFW
          #      ufw:
          #        rule: allow
          #        name: "Apache Full"
          #        state: enabled

    - name: Create a simple HTML web page
      copy:
        content: "Welcome to the Ansible learning"
        dest: /var/www/html/index.html

    - name: Define web server name (www.client1.e.com)
      lineinfile:
        path: /etc/apache2/apache2.conf
        line: "ServerName www.client1.e.com:80"
        insertafter: "^#ServerName"

    - name: Update its entry in /etc/hosts file
      lineinfile:
        path: /etc/hosts
        line: "192.168.1.101 www.client1.e.com"



Assignment::::8.webserver.yml 

Please perform the below tasks:

1. Install Apache and start the service on the web server.

2. Deploy a simple website on the web server.

3. Install MySQL and start the service on the database server.

4. Create a database and a user for the website.

    Ansible installed on the control node.

    Two separate hosts set up as the web server and the database server.

    SSH access from the control node to both web and database servers.


---
- name: Configure Web and Database Servers
  hosts: dev, db
  vars:
    ansible_python_interpreter: /usr/bin/python3 
  become: true

  tasks:
    # Web Server Tasks (only for hosts in 'dev' group)
    - name: Install Apache on Web Server
      apt:
        name: apache2
        state: present
      when: "'dev' in group_names"
      notify: Restart Apache

    - name: Deploy Website on Web Server
      copy:
        src: index.html
        dest: /var/www/html/index.html
      when: "'dev' in group_names"

    - name: Start Apache Service
      service:
        name: apache2
        state: started
      when: "'dev' in group_names"

    # Database Server Tasks (only for hosts in 'db' group)
    - name: Install MariaDB on Database Server
      apt:
        name: mariadb-server
        state: present
      when: "'db' in group_names"
      notify: Restart MySQL

    - name: Start MariaDB Service
      service:
        name: mariadb
        state: started
      when: "'db' in group_names"



    - name: Install required system packages
      apt:
        name:
          - python3-pip
          - python3-venv
          - python3-dev
          - libmariadb-dev-compat
          - libmariadb-dev
        state: present
        update_cache: yes
      when: "'db' in group_names"
    
    - name: Create a virtual environment
      command: python3 -m venv /opt/venv
      args:
        creates: /opt/venv/bin/python
      when: "'db' in group_names"

    - name: Install mysqlclient in the virtual environment
      pip:
        name: mysqlclient
        executable: /opt/venv/bin/pip
        state: present
      when: "'db' in group_names"

    - name: Set Python interpreter to the virtual environment
      ansible.builtin.set_fact:
        ansible_python_interpreter: /opt/venv/bin/python
      when: "'db' in group_names"


    - name: Create Database for Website
      mysql_db:
        name: mydb
        state: present
      when: "'db' in group_names"

    - name: Create MySQL User and Grant Privileges
      mysql_user:
        name: myuser
        password: mypassword
        priv: 'mydb.*:ALL'
        state: present
      when: "'db' in group_names"

  handlers:
    # Handler for Apache
    - name: Restart Apache
      service:
        name: apache2
        state: restarted
      when: "'dev' in group_names"

    # Handler for MySQL
    - name: Restart MySQL
      service:
        name: mysql
        state: restarted
      when: "'db' in group_names"

